# Copy to server/.env for local development.
# On Vercel, add the same variables in Project Settings -> Environment Variables.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/buildmetric
# SSL for hosted databases (Neon, Supabase, Render, ...):
#   true       encrypted and the server certificate is verified (recommended)
#   no-verify  encrypted but not verified (avoid: the connection can be intercepted)
#   false      no SSL (local Postgres)
DATABASE_SSL=false
# Optional: the provider's CA certificate (PEM, with \n for line breaks) if it uses its own CA
# DATABASE_SSL_CA=

# Number of proxies in front of the API (for the client IP used by rate limiting).
# Leave empty locally. On Vercel it defaults to 1. Behind one load balancer: 1.
TRUST_PROXY=

# Long random string used to sign login sessions
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Local API port (Vite proxies /api to this port)
PORT=4000

# Admin login for /admin, created or reset by: npm run db:setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=BuildMetric Administrator
